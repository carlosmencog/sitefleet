POSTGRES_PASSWORD=local-only-change-me
# Generate a distinct 32-byte base64 key before any real deployment.
SITEFLEET_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-this-local-password
# Makes *.local WordPress sites reachable from Chromium inside the dashboard container.
# Use "MAP *.local 127.0.0.1" when running the dashboard directly on the host instead.
LOCAL_LIGHTHOUSE_RESOLVER_RULES=MAP *.local host.docker.internal
